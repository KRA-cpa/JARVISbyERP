# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Google Apps Script API
REACT_APP_GOOGLE_APPS_SCRIPT_URL=your_gas_api_url_here

# App Configuration
REACT_APP_NAME=Ticketing & Workflow System
REACT_APP_TIMEZONE=Asia/Manila
REACT_APP_DEFAULT_COMPANY_ID=1

# Development Toggles
REACT_APP_DISABLE_AUTH=true
REACT_APP_USE_MOCK_DATA=true
REACT_APP_SHOW_DEBUG=true
REACT_APP_SHOW_API_PANEL=true

# Allow direct access to protected pages (for setup phase before auth is configured)
# Set to 'false' when authentication is ready for production
REACT_APP_ALLOW_DIRECT_ACCESS=true

# Stats Display Toggles (set to false to hide in live)
REACT_APP_SHOW_USER_COUNT=true
REACT_APP_SHOW_TICKET_COUNT=true
REACT_APP_SHOW_COMPANY_COUNT=true
REACT_APP_SHOW_SYSTEM_HEALTH=true
REACT_APP_SHOW_MODULE_STATS=true
REACT_APP_SHOW_API_STATUS=true
REACT_APP_SHOW_BACKEND_INFO=true